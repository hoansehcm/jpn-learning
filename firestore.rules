rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "hoangnnse183499@fpt.edu.vn" && request.auth.token.email_verified == true));
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    function isValidUser(data) {
      return hasOnlyAllowedFields(['uid', 'displayName', 'email', 'photoURL', 'targetLevel', 'dailyGoal', 'streak', 'lastStudyDate', 'role']) &&
             data.uid is string &&
             data.email is string &&
             data.role in ['user', 'admin'];
    }

    function isValidVocabulary(data) {
      return hasOnlyAllowedFields(['word', 'kana', 'romaji', 'meaning', 'level', 'type', 'examples']) &&
             data.word is string && data.word.size() > 0 && data.word.size() < 100 &&
             data.kana is string && data.kana.size() > 0 && data.kana.size() < 100 &&
             data.meaning is string && data.meaning.size() > 0 && data.meaning.size() < 500 &&
             data.level in ['N5', 'N4', 'N3', 'N2', 'N1'];
    }

    function isValidGrammar(data) {
      return hasOnlyAllowedFields(['pattern', 'meaning', 'explanation', 'level', 'examples']) &&
             data.pattern is string && data.pattern.size() > 0 && data.pattern.size() < 200 &&
             data.meaning is string && data.meaning.size() > 0 && data.meaning.size() < 500 &&
             data.level in ['N5', 'N4', 'N3', 'N2', 'N1'];
    }

    function isValidKanji(data) {
      return hasOnlyAllowedFields([
               'kanji',
               'meaning',
               'meanings',
               'level',
               'onyomi',
               'kunyomi',
               'readings',
               'meta',
               'strokeCount',
               'examples',
               'exampleVocabulary',
               'searchableText'
             ]) &&
             data.kanji is string && data.kanji.size() > 0 && data.kanji.size() < 10 &&
             data.meaning is string && data.meaning.size() > 0 && data.meaning.size() < 200 &&
             data.level in ['N5', 'N4', 'N3', 'N2', 'N1'] &&
             (!('meanings' in data) || data.meanings is list) &&
             (!('readings' in data) || data.readings is map) &&
             (!('meta' in data) || data.meta is map) &&
             (!('examples' in data) || data.examples is list) &&
             (!('exampleVocabulary' in data) || data.exampleVocabulary is list) &&
             (!('searchableText' in data) || data.searchableText is string);
    }

    function isValidSavedItem(data) {
      return hasOnlyAllowedFields(['userId', 'itemId', 'itemType', 'addedAt']) &&
             data.userId is string &&
             data.itemId is string &&
             data.itemType in ['vocabulary', 'grammar', 'kanji'] &&
             data.addedAt is string;
    }

    function isValidReviewItem(data) {
      return hasOnlyAllowedFields(['userId', 'itemId', 'itemType', 'nextReviewDate', 'interval', 'easeFactor', 'repetitions', 'status']) &&
             data.userId is string &&
             data.itemId is string &&
             data.itemType in ['vocabulary', 'grammar', 'kanji'] &&
             data.nextReviewDate is string &&
             data.interval is number &&
             data.easeFactor is number &&
             data.repetitions is number &&
             data.status in ['new', 'learning', 'reviewing', 'mastered'];
    }

    // ===============================================================
    // Rules
    // ===============================================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && isOwner(userId) && isValidUser(request.resource.data) && uidUnchanged() && (request.resource.data.role == 'user' || isAdmin());
      allow update: if isAuthenticated() && isOwner(userId) && isValidUser(request.resource.data) && uidNotModified() && (request.resource.data.role == resource.data.role || isAdmin());
      allow delete: if isAdmin();

      match /savedItems/{savedItemId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidSavedItem(request.resource.data) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidSavedItem(request.resource.data) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /reviewItems/{reviewItemId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidReviewItem(request.resource.data) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidReviewItem(request.resource.data) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    match /vocabulary/{vocabId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && (request.method == 'delete' || isValidVocabulary(request.resource.data));
    }

    match /grammar/{grammarId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && (request.method == 'delete' || isValidGrammar(request.resource.data));
    }

    match /kanji/{kanjiId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && (request.method == 'delete' || isValidKanji(request.resource.data));
    }
  }
}
